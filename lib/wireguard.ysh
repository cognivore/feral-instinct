#!/usr/bin/env ysh
# WireGuard mesh configuration generator and deployer
#
# Generates full-mesh configurations for all nodes and deploys via SSH.

# Source guard
if test -n "${_WIREGUARD_SOURCED:-}" {
  return 0
}
setglobal _WIREGUARD_SOURCED = "1"

# Determine lib directory for cross-library sourcing
var _lib_dir = "${WG_MESH_LIB:-$_this_dir}"

source "$_lib_dir/passveil.ysh"
source "$_lib_dir/ramnode.ysh"
source "$_lib_dir/flokinet.ysh"

# WireGuard mesh network configuration
const WG_INTERFACE = "wg0"
const WG_PORT = 51820
const WG_NETWORK = "10.100.0.0/24"  # Internal mesh network

# Node definitions for the mesh
# Each node gets a unique internal IP in the 10.100.0.x range
const MESH_NODES = {
  "ramnode-sea": {
    provider: "ramnode",
    location: "seattle",
    internal_ip: "10.100.0.1",
    name: "US West (Seattle)"
  },
  "ramnode-nyc": {
    provider: "ramnode",
    location: "nyc",
    internal_ip: "10.100.0.2",
    name: "US East (NYC)"
  },
  "ramnode-la": {
    provider: "ramnode",
    location: "la",
    internal_ip: "10.100.0.3",
    name: "US West (LA)"
  },
  "ramnode-atl": {
    provider: "ramnode",
    location: "atlanta",
    internal_ip: "10.100.0.4",
    name: "US South (Atlanta)"
  },
  "flokinet-fi": {
    provider: "flokinet",
    location: "fi",
    internal_ip: "10.100.0.5",
    name: "Nordic (Finland)"
  },
  "flokinet-nl": {
    provider: "flokinet",
    location: "nl",
    internal_ip: "10.100.0.6",
    name: "EU (Netherlands)"
  },
  "flokinet-is": {
    provider: "flokinet",
    location: "iceland",
    internal_ip: "10.100.0.7",
    name: "Nordic (Iceland)"
  },
  "flokinet-ro": {
    provider: "flokinet",
    location: "ro",
    internal_ip: "10.100.0.8",
    name: "EU East (Romania)"
  }
}

# Client node (local machine)
const CLIENT_NODE = {
  internal_ip: "10.100.0.100",
  name: "Client"
}

# Get node information from passveil
proc wg-get-node-info (node_key) {
  var node = MESH_NODES[node_key]
  if (node === null) {
    echo "Error: Unknown node '$node_key'" >&2
    return 1
  }

  var provider = node['provider']
  var location = node['location']
  var node_path = "wireguard-mesh/$provider-$location"

  var ip = $(passveil-get "$node_path/ip" 2>/dev/null)
  var pubkey = $(passveil-get "$node_path/wg-public-key" 2>/dev/null)

  if (ip === '') {
    echo "Error: Node $node_key not provisioned (no IP found)" >&2
    return 1
  }

  # Return node info
  var internal_ip = node['internal_ip']
  var node_name = node['name']
  echo "node_key=$node_key"
  echo "provider=$provider"
  echo "location=$location"
  echo "public_ip=$ip"
  echo "internal_ip=$internal_ip"
  echo "wg_pubkey=$pubkey"
  echo "name=$node_name"
}

# Generate WireGuard private key
proc wg-generate-keypair (node_key) {
  var node_path = "wireguard-mesh/$node_key"

  # Check if keys already exist
  var existing_priv = $(passveil-get "$node_path/wg-private-key" 2>/dev/null)
  if (existing_priv !== '') {
    print-info "Keys already exist for $node_key"
    return 0
  }

  # Generate new keypair using wg command
  var private_key = $(wg genkey)
  var public_key = $(echo $private_key | wg pubkey)

  # Store in passveil
  passveil-store "$node_path/wg-private-key" $private_key
  passveil-store "$node_path/wg-public-key" $public_key

  print-success "Generated keypair for $node_key"
  print-info "Public key: $public_key"

  return 0
}

# Generate WireGuard config for a specific node
proc wg-generate-node-config (node_key) {
  var node = MESH_NODES[node_key]
  if (node === null) {
    echo "Error: Unknown node '$node_key'" >&2
    return 1
  }

  var provider = node['provider']
  var location = node['location']
  var node_path = "wireguard-mesh/$provider-$location"
  var internal_ip = node['internal_ip']
  var node_name = node['name']

  # Get this node's private key
  var private_key = $(passveil-get "$node_path/wg-private-key" 2>/dev/null)
  if (private_key === '') {
    echo "Error: No private key for $node_key. Generate keys first." >&2
    return 1
  }

  # Start building config
  cat << EOF
# WireGuard configuration for $node_key
# $node_name
# Generated by wireguard-mesh

[Interface]
PrivateKey = $private_key
Address = $internal_ip/24
ListenPort = $WG_PORT
# Enable forwarding for mesh routing
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

EOF

  # Add peer sections for all other nodes
  for peer_key in (MESH_NODES) {
    if (peer_key === node_key) {
      continue  # Skip self
    }

    var peer = MESH_NODES[peer_key]
    var peer_provider = peer['provider']
    var peer_location = peer['location']
    var peer_path = "wireguard-mesh/$peer_provider-$peer_location"

    var peer_pubkey = $(passveil-get "$peer_path/wg-public-key" 2>/dev/null)
    var peer_public_ip = $(passveil-get "$peer_path/ip" 2>/dev/null)
    var peer_internal_ip = peer['internal_ip']
    var peer_name = peer['name']

    if (peer_pubkey === '' or peer_public_ip === '') {
      echo "# Peer $peer_key: NOT CONFIGURED (skipped)"
      continue
    }

    cat << EOF
# Peer: $peer_key ($peer_name)
[Peer]
PublicKey = $peer_pubkey
Endpoint = $peer_public_ip:$WG_PORT
AllowedIPs = $peer_internal_ip/32
PersistentKeepalive = 25

EOF
  }
}

# Generate client configuration for connecting to the mesh
proc wg-generate-client-config {
  print-header "Generating Client Configuration"

  var client_path = "wireguard-mesh/client"

  # Generate client keys if needed
  var client_priv = $(passveil-get "$client_path/wg-private-key" 2>/dev/null)
  if (client_priv === '') {
    print-info "Generating client keypair..."
    var private_key = $(wg genkey)
    var public_key = $(echo $private_key | wg pubkey)
    passveil-store "$client_path/wg-private-key" $private_key
    passveil-store "$client_path/wg-public-key" $public_key
    setvar client_priv = private_key
  }

  var client_pub = $(passveil-get "$client_path/wg-public-key")
  var client_ip = CLIENT_NODE['internal_ip']

  echo "# WireGuard Client Configuration"
  echo "# Connect to your mesh VPN"
  echo "# Generated by wireguard-mesh"
  echo ""
  echo "[Interface]"
  echo "PrivateKey = $client_priv"
  echo "Address = $client_ip/24"
  echo "DNS = 1.1.1.1, 8.8.8.8"
  echo ""

  # Add all mesh nodes as peers (client can connect to any)
  for node_key in (MESH_NODES) {
    var node = MESH_NODES[node_key]
    var provider = node['provider']
    var location = node['location']
    var node_path = "wireguard-mesh/$provider-$location"

    var pubkey = $(passveil-get "$node_path/wg-public-key" 2>/dev/null)
    var public_ip = $(passveil-get "$node_path/ip" 2>/dev/null)
    var internal_ip = node['internal_ip']
    var node_name = node['name']

    if (pubkey === '' or public_ip === '') {
      continue
    }

    echo "# $node_name ($node_key)"
    echo "[Peer]"
    echo "PublicKey = $pubkey"
    echo "Endpoint = $public_ip:$WG_PORT"
    echo "AllowedIPs = 0.0.0.0/0  # Route all traffic through this peer"
    echo "# AllowedIPs = $internal_ip/32, 10.100.0.0/24  # Or just mesh traffic"
    echo "PersistentKeepalive = 25"
    echo ""
  }

  echo ""
  print-info "Client public key (add to mesh nodes): $client_pub"
}

# Deploy configuration to a node via SSH
proc wg-deploy-to-node (node_key) {
  var node = MESH_NODES[node_key]
  if (node === null) {
    echo "Error: Unknown node '$node_key'" >&2
    return 1
  }

  var provider = node['provider']
  var location = node['location']
  var node_path = "wireguard-mesh/$provider-$location"

  var public_ip = $(passveil-get "$node_path/ip" 2>/dev/null)
  if (public_ip === '') {
    echo "Error: No IP for $node_key" >&2
    return 1
  }

  print-info "Deploying WireGuard config to $node_key ($public_ip)..."

  # Generate config
  var config = $(wg-generate-node-config $node_key)

  # Deploy via SSH
  echo "$config" | ssh root@$public_ip "cat > /etc/wireguard/$WG_INTERFACE.conf && chmod 600 /etc/wireguard/$WG_INTERFACE.conf"

  if (_status !== 0) {
    echo "Error: Failed to deploy config to $node_key" >&2
    return 1
  }

  # Enable and start WireGuard
  ssh root@$public_ip "systemctl enable wg-quick@$WG_INTERFACE && systemctl restart wg-quick@$WG_INTERFACE"

  if (_status !== 0) {
    echo "Error: Failed to start WireGuard on $node_key" >&2
    return 1
  }

  print-success "Deployed and started WireGuard on $node_key"
  return 0
}

# Deploy to all configured nodes
proc wg-deploy-mesh {
  print-header "Deploying WireGuard Mesh"

  var deployed = 0
  var failed = 0

  for node_key in (MESH_NODES) {
    var node = MESH_NODES[node_key]
    var provider = node['provider']
    var location = node['location']
    var node_path = "wireguard-mesh/$provider-$location"

    var ip = $(passveil-get "$node_path/ip" 2>/dev/null)
    if (ip === '') {
      print-info "Skipping $node_key (not provisioned)"
      continue
    }

    try {
      wg-deploy-to-node $node_key
    }
    if (_status === 0) {
      setvar deployed = deployed + 1
    } else {
      setvar failed = failed + 1
    }
  }

  echo ""
  print-header "Deployment Summary"
  echo "Deployed: $deployed"
  echo "Failed: $failed"

  if (failed > 0) {
    return 1
  }
  return 0
}

# Add client as peer to all mesh nodes
proc wg-add-client-to-mesh {
  var client_path = "wireguard-mesh/client"
  var client_pub = $(passveil-get "$client_path/wg-public-key" 2>/dev/null)
  var client_ip = CLIENT_NODE['internal_ip']

  if (client_pub === '') {
    echo "Error: No client public key. Generate client config first." >&2
    return 1
  }

  print-header "Adding Client to Mesh Nodes"

  for node_key in (MESH_NODES) {
    var node = MESH_NODES[node_key]
    var provider = node['provider']
    var location = node['location']
    var node_path = "wireguard-mesh/$provider-$location"

    var public_ip = $(passveil-get "$node_path/ip" 2>/dev/null)
    if (public_ip === '') {
      continue
    }

    print-info "Adding client to $node_key..."

    # Add client peer to the node
    ssh root@$public_ip << EOF
      # Add client peer if not exists
      if ! wg show $WG_INTERFACE peers | grep -q "$client_pub"; then
        wg set $WG_INTERFACE peer "$client_pub" allowed-ips "$client_ip/32"
        # Save to config
        wg-quick save $WG_INTERFACE
        echo "Client added to $node_key"
      else
        echo "Client already configured on $node_key"
      fi
EOF

    if (_status === 0) {
      print-success "Client added to $node_key"
    } else {
      echo "${COLOR_YELLOW}Warning: Could not add client to $node_key${COLOR_RESET}"
    }
  }
}

# Show mesh status
proc wg-mesh-status {
  print-header "WireGuard Mesh Status"

  for node_key in (MESH_NODES) {
    var node = MESH_NODES[node_key]
    var provider = node['provider']
    var location = node['location']
    var node_path = "wireguard-mesh/$provider-$location"

    var public_ip = $(passveil-get "$node_path/ip" 2>/dev/null)
    var pubkey = $(passveil-get "$node_path/wg-public-key" 2>/dev/null)
    var internal_ip = node['internal_ip']
    var node_name = node['name']

    echo "${COLOR_BOLD}$node_key${COLOR_RESET} - $node_name"

    if (public_ip === '') {
      echo "  Status: ${COLOR_YELLOW}Not provisioned${COLOR_RESET}"
      echo ""
      continue
    }

    echo "  Public IP: $public_ip"
    echo "  Internal IP: $internal_ip"

    if (pubkey !== '') {
      var pubkey_short = pubkey[:20]
      echo "  WG Public Key: $pubkey_short..."
    }

    # Try to get live status via SSH
    try {
      var wg_status = $(ssh -o ConnectTimeout=5 root@$public_ip "wg show $WG_INTERFACE 2>/dev/null | head -5" 2>/dev/null)
      if (wg_status !== '') {
        echo "  WireGuard: ${COLOR_GREEN}Running${COLOR_RESET}"
      } else {
        echo "  WireGuard: ${COLOR_YELLOW}Not running${COLOR_RESET}"
      }
    }
    if (_status !== 0) {
      echo "  WireGuard: ${COLOR_YELLOW}Unable to check${COLOR_RESET}"
    }

    echo ""
  }
}

# Test mesh connectivity
proc wg-test-mesh {
  print-header "Testing Mesh Connectivity"

  # Get first available node to run tests from
  var test_node = ''
  var test_ip = ''

  for node_key in (MESH_NODES) {
    var node = MESH_NODES[node_key]
    var provider = node['provider']
    var location = node['location']
    var node_path = "wireguard-mesh/$provider-$location"

    var ip = $(passveil-get "$node_path/ip" 2>/dev/null)
    if (ip !== '') {
      setvar test_node = node_key
      setvar test_ip = ip
      break
    }
  }

  if (test_node === '') {
    echo "Error: No nodes available to run tests from" >&2
    return 1
  }

  print-info "Running connectivity tests from $test_node..."
  echo ""

  for node_key in (MESH_NODES) {
    if (node_key === test_node) {
      continue
    }

    var target_node = MESH_NODES[node_key]
    var target_internal_ip = target_node['internal_ip']

    echo -n "  $test_node → $node_key ($target_internal_ip): "

    var result = $(ssh root@$test_ip "ping -c 2 -W 2 $target_internal_ip >/dev/null 2>&1 && echo 'OK' || echo 'FAIL'")

    if (result === 'OK') {
      echo "${COLOR_GREEN}✓ Reachable${COLOR_RESET}"
    } else {
      echo "${COLOR_RED}✗ Unreachable${COLOR_RESET}"
    }
  }
}

