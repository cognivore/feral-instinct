# WireGuard Configuration Template
# Generated by wireguard-mesh
#
# Variables:
#   {{PRIVATE_KEY}}    - Node's private key
#   {{ADDRESS}}        - Node's internal mesh IP (e.g., 10.100.0.1/24)
#   {{LISTEN_PORT}}    - WireGuard port (default: 51820)
#   {{PEERS}}          - Peer configuration sections

[Interface]
PrivateKey = {{PRIVATE_KEY}}
Address = {{ADDRESS}}
ListenPort = {{LISTEN_PORT}}

# Enable IP forwarding for mesh routing
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

{{PEERS}}

# Peer Template:
# [Peer]
# PublicKey = {{PEER_PUBLIC_KEY}}
# Endpoint = {{PEER_ENDPOINT}}:{{LISTEN_PORT}}
# AllowedIPs = {{PEER_INTERNAL_IP}}/32
# PersistentKeepalive = 25

